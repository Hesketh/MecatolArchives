@page "/variants"
@rendermode InteractiveServer
@inject MecatolArchivesApiClient ApiClient

<PageTitle>Variants</PageTitle>

<h1>Variants</h1>

@if (variants == null)
{
    <p>Loading...</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var variant in variants)
            {
                <tr>
                    <td>@variant.Name</td>
                    <td>
                        <button class="btn btn-danger btn-sm" @onclick="() => Delete(variant.Identifier)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<h2>Add Variant</h2>
<EditForm Model="newVariant" OnValidSubmit="Create">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label class="form-label">Name</label>
        <InputText class="form-control" @bind-Value="newVariant.Name" />
        <ValidationMessage For="() => newVariant.Name" />
    </div>
    <button type="submit" class="btn btn-primary">Add</button>
</EditForm>

@code {
    private List<Variant>? variants;
    private VariantCreateRequest newVariant = new() { Name = "" };
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var result = await ApiClient.Variants.ReadAsync(new QueryParameters { PageSize = 200 });
        variants = [.. result.Items];
    }

    private async Task Create()
    {
        try
        {
            errorMessage = null;
            await ApiClient.Variants.CreateAsync(newVariant);
            newVariant = new() { Name = "" };
            await LoadData();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task Delete(Guid id)
    {
        await ApiClient.Variants.DeleteAsync(id);
        await LoadData();
    }
}
